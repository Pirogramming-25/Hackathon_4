   "html": "\n      <div class=\"app-bar\">연락처</div>\n      <div class=\"relative flex-1\">\n        <div class=\"phone-row\"><span aria-hidden=\"true\">👴</span><span>박철수</span></div>\n        <div class=\"phone-row\"><span aria-hidden=\"true\">👩</span><span>이순자</span></div>\n        <div class=\"phone-row\"><span aria-hidden=\"true\">👨</span><span>최민호</span></div>\n        <button type=\"button\" class=\"tap-target fab\" data-tap=\"correct\" aria-label=\"연락처 추가\">＋</button>\n      </div>"
  },
