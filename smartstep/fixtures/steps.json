   "html": "\n      <div class=\"app-bar\">연락처 추가</div>\n      <div class=\"flex flex-1 flex-col gap-3 px-4 pad-t\">\n        <div class=\"field\"><p class=\"field__label\">이름</p><p class=\"field__value\">김영희</p></div>\n        <button type=\"button\" class=\"tap-target tap-target--block\" data-tap=\"correct\" aria-label=\"전화번호 입력란\"><div class=\"field\"><p class=\"field__label\">전화번호</p><p class=\"field__value field__value--empty\">번호를 입력하세요</p></div></button>\n      </div>"
