   "html": "\n      <div class=\"app-bar\">전화</div>\n      <div class=\"flex flex-1 flex-col justify-end gap-4 px-6 pb-6\">\n        <p class=\"text-center font-bold\" style=\"font-size:1.5rem;letter-spacing:.1em;color:var(--phone-fg);\">010-1234-5678</p>\n        <div class=\"keypad\"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span><span>*</span><span>0</span><span>#</span></div>\n        <button type=\"button\" class=\"tap-target call-btn\" data-tap=\"correct\" aria-label=\"통화 걸기\">📞</button>\n      </div>"
